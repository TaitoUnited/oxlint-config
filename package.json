{
  "name": "@taito/oxlint-config",
  "version": "0.1.0",
  "description": "Shared Oxlint configuration and custom lint rules for Taito United's JavaScript and TypeScript projects.",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "oxlint-plugin",
    "lint",
    "typescript",
    "react",
    "taito"
  ],
  "homepage": "https://github.com/TaitoUnited/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/TaitoUnited/oxlint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaitoUnited/oxlint-config.git"
  },
  "license": "MIT",
  "author": "Taito United",
  "type": "module",
  "exports": {
    ".": {
      "types": "./configs/index.d.ts",
      "default": "./configs/base.js"
    },
    "./base": {
      "types": "./configs/index.d.ts",
      "default": "./configs/base.js"
    },
    "./node": {
      "types": "./configs/index.d.ts",
      "default": "./configs/node.js"
    },
    "./react": {
      "types": "./configs/react.d.ts",
      "default": "./configs/react.js"
    },
    "./vitest": {
      "types": "./configs/index.d.ts",
      "default": "./configs/vitest.js"
    },
    "./playwright": {
      "types": "./configs/index.d.ts",
      "default": "./configs/playwright.js"
    },
    "./lingui": {
      "types": "./configs/index.d.ts",
      "default": "./configs/lingui.js"
    },
    "./panda": {
      "types": "./configs/index.d.ts",
      "default": "./configs/panda.js"
    },
    "./plugin": {
      "types": "./plugin/index.d.ts",
      "default": "./plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "configs",
    "plugin",
    "!**/*.test.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run format:check && npm test",
    "pack:check": "npm pack --dry-run",
    "release": "np",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "eslint-plugin-lingui": "0.16.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-dom": "5.30.6",
    "eslint-plugin-react-jsx": "5.30.6",
    "eslint-plugin-react-naming-convention": "5.30.6",
    "eslint-plugin-react-web-api": "5.30.6",
    "eslint-plugin-react-x": "5.30.6"
  },
  "devDependencies": {
    "np": "12.1.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "oxlint": "^1.94.0",
    "tsrs": ">=7.1.0-beta.tsrs3"
  },
  "peerDependenciesMeta": {
    "tsrs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "np": {
    "branch": "main",
    "testScript": "verify",
    "message": "chore: release v%s"
  }
}
